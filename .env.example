MCP_TRANSPORT=stdio              # stdio | http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_BEARER_TOKEN=           # required when MCP_TRANSPORT=http

ETF_MCP_CACHE=~/.cache/etf-mcp/cache.db
CACHE_TTL_QUOTE=300
CACHE_TTL_PROFILE=86400
CACHE_TTL_HISTORY=3600

LOG_LEVEL=INFO

OPENFIGI_API_KEY=            # optional; raises rate limit from 25/min to 25/6s
