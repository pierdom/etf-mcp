ETF_SCOUT_MCP_TRANSPORT=stdio              # stdio | http
ETF_SCOUT_MCP_HTTP_HOST=127.0.0.1
ETF_SCOUT_MCP_HTTP_PORT=8765
ETF_SCOUT_MCP_HTTP_BEARER_TOKEN=           # http auth fallback (machine-to-machine); generate with: openssl rand -hex 32

# OIDC / remote OAuth — for Claude apps (mobile/desktop). Takes precedence over the bearer token.
# When all four below are set, the server brokers login to the IdP (FastMCP OIDCProxy).
# Register a confidential client on the IdP with redirect URI <OIDC_BASE_URL><OIDC_REDIRECT_PATH>.
OIDC_CONFIG_URL=            # e.g. https://id.example.com/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BASE_URL=             # public URL, e.g. https://etf-scout-mcp.example.com
OIDC_REDIRECT_PATH=/auth/callback
OIDC_REQUIRED_SCOPES=      # optional, comma-separated
OIDC_ALLOWED_REDIRECT_URIS=   # lock to Claude, e.g. https://claude.ai/*,https://claude.com/*
OIDC_VERIFY_ID_TOKEN=false    # true if the IdP issues opaque (non-JWT) access tokens
OIDC_FORWARD_RESOURCE=false   # PocketID & many IdPs reject the RFC 8707 resource indicator

ETF_SCOUT_MCP_CACHE=~/.cache/etf-scout-mcp/cache.db
ETF_SCOUT_MCP_CACHE_TTL_QUOTE=300
ETF_SCOUT_MCP_CACHE_TTL_PROFILE=86400
ETF_SCOUT_MCP_CACHE_TTL_HISTORY=3600

ETF_SCOUT_MCP_LOG_LEVEL=INFO

OPENFIGI_API_KEY=            # optional; raises rate limit from 25/min to 25/6s
